{
  "name": "fitpose",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "fitpose-native": "file:modules/fitpose-native",
    "i18next": "26.5.11",
    "react": "19.3.0",
    "react-i18next": "17.1.9",
    "react-native": "0.88.1",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-vision-camera": "5.2.4",
    "react-native-vision-camera-worklets": "5.2.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "~19.3.0",
    "eslint": "10.13.0",
    "nitrogen": "0.37.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:kinematics": "vitest run src/kinematics --exclude '**/benchmark.test.ts'",
    "i18n:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-check.ts",
    "postinstall": "bash scripts/fetch-pose-model.sh",
    "test:benchmark": "vitest run src/kinematics/__tests__/benchmark.test.ts"
  },
  "private": true
}
